# Copy to .env.local once the Sanity project exists.
# Get the project ID from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# URL of the deployed contact-form Worker (worker/README.md). When unset, the
# /contact form opens the visitor's email app instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=
