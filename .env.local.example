# Copy to .env.local once the Sanity project exists.
# Get the project ID from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production


# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank locally so dev
# visits aren't counted; production sets it via the repo's Actions variables.
NEXT_PUBLIC_GA_ID=

# Optional, local only: a Sanity token with read access renders drafts on
# localhost. Never set in CI. Your CLI token works: ~/.config/sanity/config.json
SANITY_PREVIEW_TOKEN=
